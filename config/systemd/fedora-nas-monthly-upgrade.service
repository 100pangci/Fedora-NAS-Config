[Unit]
Description=Fedora-NAS monthly full dnf5 upgrade (Sunday after last Saturday)
Documentation=file:///home/ywpc/Tools/fedora_nas_maintenance.py
After=network-online.target fedora-nas-monthly-precheck.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/ywpc/Tools/fedora_nas_maintenance.py upgrade
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=16200
UMask=0027
